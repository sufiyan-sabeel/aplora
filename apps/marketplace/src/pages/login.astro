---
import SiteShell from "@aplora/ui/components/SiteShell.astro";

const nav = [
  { label: "Apps", href: "apps/" },
  { label: "Categories", href: "categories/" },
  { label: "Search", href: "search/" },
];
---

<SiteShell title="Sign in" portal="Marketplace" nav={nav} activePath="/login/">
  <div id="view"></div>

  <script>
    import { bootstrap } from "../views/boot";
    import { renderLogin } from "../views/auth";
    bootstrap(renderLogin, "Preparing sign-in…");
  </script>
</SiteShell>
