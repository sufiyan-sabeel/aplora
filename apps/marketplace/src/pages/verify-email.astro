---
import SiteShell from "@aplora/ui/components/SiteShell.astro";

const nav = [
  { label: "Apps", href: "apps/" },
  { label: "Categories", href: "categories/" },
  { label: "Search", href: "search/" },
];
---

<SiteShell title="Confirm your email" portal="Marketplace" nav={nav} activePath="/verify-email/">
  <div id="view"></div>

  <script>
    import { bootstrap } from "../views/boot";
    import { renderVerify } from "../views/auth";
    bootstrap(renderVerify, "Confirming your email…");
  </script>
</SiteShell>
