---
import SiteShell from "@aplora/ui/components/SiteShell.astro";

const nav = [
  { label: "Apps", href: "apps/" },
  { label: "Categories", href: "categories/" },
  { label: "Search", href: "search/" },
];
---

<SiteShell title="Collection" portal="Marketplace" nav={nav} activePath="/">
  <div id="view"></div>

  <script>
    import { bootstrap } from "../views/boot";
    import { renderCollection } from "../views/taxonomy";
    bootstrap(renderCollection, "Loading collection…");
  </script>
</SiteShell>
