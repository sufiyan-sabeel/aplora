---
import SiteShell from "@aplora/ui/components/SiteShell.astro";

const nav = [
  { label: "Apps", href: "apps/" },
  { label: "Categories", href: "categories/" },
  { label: "Search", href: "search/" },
];
---

<SiteShell title="All applications" portal="Marketplace" nav={nav} activePath="/apps/">
  <div id="view"></div>

  <script>
    import { bootstrap } from "../../views/boot";
    import { renderBrowse } from "../../views/browse";
    bootstrap(renderBrowse, "Loading applications…");
  </script>
</SiteShell>
