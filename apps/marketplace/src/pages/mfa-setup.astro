---
import SiteShell from "@aplora/ui/components/SiteShell.astro";

const nav = [
  { label: "Apps", href: "apps/" },
  { label: "Categories", href: "categories/" },
  { label: "Search", href: "search/" },
];
---

<SiteShell title="Two-factor setup" portal="Marketplace" nav={nav} activePath="/mfa-setup/">
  <div id="view"></div>

  <script>
    import { bootstrap } from "../views/boot";
    import { renderMfaSetup } from "../views/mfa";
    bootstrap(renderMfaSetup, "Starting two-factor setup…");
  </script>
</SiteShell>
