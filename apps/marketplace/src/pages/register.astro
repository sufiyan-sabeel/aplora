---
import SiteShell from "@aplora/ui/components/SiteShell.astro";

const nav = [
  { label: "Apps", href: "apps/" },
  { label: "Categories", href: "categories/" },
  { label: "Search", href: "search/" },
];
---

<SiteShell title="Create an account" portal="Marketplace" nav={nav} activePath="/register/">
  <div id="view"></div>

  <script>
    import { bootstrap } from "../views/boot";
    import { renderRegister } from "../views/auth";
    bootstrap(renderRegister, "Preparing registration…");
  </script>
</SiteShell>
