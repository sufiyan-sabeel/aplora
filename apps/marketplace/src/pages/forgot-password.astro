---
import SiteShell from "@aplora/ui/components/SiteShell.astro";

const nav = [
  { label: "Apps", href: "apps/" },
  { label: "Categories", href: "categories/" },
  { label: "Search", href: "search/" },
];
---

<SiteShell title="Reset your password" portal="Marketplace" nav={nav} activePath="/forgot-password/">
  <div id="view"></div>

  <script>
    import { bootstrap } from "../views/boot";
    import { renderForgot } from "../views/auth";
    bootstrap(renderForgot, "Preparing…");
  </script>
</SiteShell>
