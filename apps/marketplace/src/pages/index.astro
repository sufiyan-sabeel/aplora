---
import SiteShell from "@aplora/ui/components/SiteShell.astro";

const nav = [
  { label: "Apps", href: "apps/" },
  { label: "Categories", href: "categories/" },
  { label: "Search", href: "search/" },
];
---

<SiteShell title="Aplora — Discover. Explore. Install." portal="Marketplace" nav={nav} activePath="/">
  <div id="view"></div>

  <script>
    import { bootstrap } from "../views/boot";
    import { renderHome } from "../views/home";
    bootstrap(renderHome, "Loading the marketplace…");
  </script>
</SiteShell>
