---
import SiteShell from "@aplora/ui/components/SiteShell.astro";

const nav = [
  { label: "Apps", href: "apps/" },
  { label: "Categories", href: "categories/" },
  { label: "Search", href: "search/" },
];
---

<SiteShell title="Choose a new password" portal="Marketplace" nav={nav} activePath="/reset-password/">
  <div id="view"></div>

  <script>
    import { bootstrap } from "../views/boot";
    import { renderReset } from "../views/auth";
    bootstrap(renderReset, "Preparing…");
  </script>
</SiteShell>
