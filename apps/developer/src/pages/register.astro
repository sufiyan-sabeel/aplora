---
import SiteShell from "@aplora/ui/components/SiteShell.astro";

const nav = [
  { label: "Dashboard", href: "" },
  { label: "Applications", href: "apps/" },
  { label: "Submissions", href: "submissions/" },
  { label: "Analytics", href: "analytics/" },
  { label: "Profile", href: "profile/" },
];
---

<SiteShell title="Developer sign up" portal="Developer" nav={nav} activePath="/register/">
  <div id="view"></div>

  <script>
    import { bootstrap } from "../views/boot";
    import { renderRegister } from "../views/auth";
    bootstrap(renderRegister, "Preparing registration…");
  </script>
</SiteShell>
