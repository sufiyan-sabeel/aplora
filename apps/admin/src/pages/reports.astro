---
import SiteShell from "@aplora/ui/components/SiteShell.astro";

const nav = [
  { label: "Dashboard", href: "" },
  { label: "Submissions", href: "submissions/" },
  { label: "Applications", href: "apps/" },
  { label: "Users", href: "users/" },
  { label: "Developers", href: "developers/" },
  { label: "Reports", href: "reports/" },
  { label: "Reviews", href: "reviews/" },
  { label: "Taxonomy", href: "categories/" },
  { label: "Audit log", href: "audit-logs/" },
  { label: "Settings", href: "settings/" },
];
---

<SiteShell title="Reports" portal="Admin" nav={nav} activePath="/reports/">
  <div id="view"></div>

  <script>
    import { bootstrap } from "../views/boot";
    import { renderReports } from "../views/reports";
    bootstrap(renderReports, "Loading reports…");
  </script>
</SiteShell>
