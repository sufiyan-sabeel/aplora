# ---------------------------------------------------------------------------
# Aplora environment configuration
# Copy to .env (never commit .env) and adjust the values.
# ---------------------------------------------------------------------------

NODE_ENV=development

API_HOST=0.0.0.0
API_PORT=4000

# Public base URL of the API (used for absolute links, CORS and emails)
API_PUBLIC_URL=http://localhost:4000

DATABASE_URL=postgresql://aplora:aplora@localhost:5432/aplora

# Long random secret (32+ chars). Used to sign sessions, CSRF tokens and
# short-lived download URLs. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret

# Session lifetime in hours
SESSION_TTL_HOURS=168

# Cookie security: leave "false" for http://localhost, set "true" in production
COOKIE_SECURE=false
COOKIE_DOMAIN=
# "lax" when the portals and the API share a site (example.com + api.example.com).
# "none" when the frontend is on another site such as GitHub Pages — and then
# COOKIE_SECURE must be true.
COOKIE_SAMESITE=lax

# Storage adapter: "local" or "s3" (MinIO / any S3-compatible service)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=aplora-storage
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true

# Allowed origins for CORS. With a static deployment on GitHub Pages these are
# the Pages URLs; locally they are the dev servers.
PUBLIC_MARKETPLACE_URL=http://localhost:4321
PUBLIC_DEVELOPER_URL=http://localhost:4322
PUBLIC_ADMIN_URL=http://localhost:4323

# Frontend build configuration. Public, non-secret, inlined into the static
# bundle. Used by `npm run build:pages`, and by GitHub Actions from the
# PUBLIC_API_BASE_URL repository variable.
PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Upload limits
MAX_APK_SIZE_MB=200
MAX_IMAGE_SIZE_MB=8

# APK scanning. "local" runs the built-in static analysis only.
# "clamav" additionally talks to a clamd daemon (optional, free).
MALWARE_SCANNER=local
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Email. "console" prints messages to the log, "smtp" sends through SMTP
# (Mailpit on localhost:1025 in development, any SMTP provider in production).
MAIL_TRANSPORT=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Aplora <no-reply@aplora.local>"

# Background jobs (pg-boss, PostgreSQL-backed — no Redis required)
WORKER_QUEUE_SCHEMA=pgboss

# Admin MFA
MFA_ISSUER=Aplora

# Optional: credentials for the first administrator created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@aplora.local
SEED_ADMIN_PASSWORD=ChangeMe12345!
